# ProfPilot backend environment

# Required for authentication.
SECRET_KEY=replace-with-a-long-random-secret

# Required for signed AI action proposals.
PROFPILOT_ACTION_SECRET=replace-with-a-different-long-random-secret

# Optional transactional email through Resend.
# When configured, confirmed class cancellation/rescheduling
# automatically emails enrolled students who have email addresses.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=ProfPilot <notifications@example.com>
# Optional override for local/testing:
# RESEND_API_URL=https://api.resend.com/emails
