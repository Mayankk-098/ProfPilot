# ProfPilot backend environment

# Required for authentication.
SECRET_KEY=replace-with-a-long-random-secret

# Required for signed AI action proposals.
PROFPILOT_ACTION_SECRET=replace-with-a-different-long-random-secret

# Database. Local development may omit this to use SQLite.
# Hosted deployments should set this to a PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Free Gmail notification gateway through Google Apps Script.
# Keep the secret private and DO NOT commit your real value.
EMAIL_GATEWAY_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
EMAIL_GATEWAY_SECRET=replace-with-a-long-random-gateway-secret
